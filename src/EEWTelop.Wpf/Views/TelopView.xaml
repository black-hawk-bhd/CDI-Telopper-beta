<UserControl x:Class="EEWTelop.Wpf.Views.TelopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:EEWTelop.Wpf.Converters"
             xmlns:controls="clr-namespace:EEWTelop.Wpf.Controls"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <conv:BackgroundModeToBrushConverter x:Key="BackgroundBrush" />
        <conv:EewLinePositionConverter x:Key="EewLinePosition" />
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <Style TargetType="controls:OutlinedText">
            <Setter Property="FontFamily"
                    Value="{Binding DataContext.SubtitleFontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </Style>
        <Style x:Key="EewBlockBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="24,6" />
            <Setter Property="Margin" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEewHeader}" Value="True">
                    <Setter Property="Background" Value="#FFA83218" />
                    <Setter Property="Padding" Value="24,16" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StyleToken}" Value="eew-header-cancel">
                    <Setter Property="Background" Value="#FF555555" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.IsConcurrentEewProgram, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                    <Setter Property="Padding" Value="18,8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EewText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily"
                    Value="{Binding DataContext.SubtitleFontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="2" Opacity="1" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EewPrimaryText" TargetType="TextBlock" BasedOn="{StaticResource EewText}">
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="FontSize"
                    Value="{Binding DataContext.EewBodyFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter Property="LineHeight"
                    Value="{Binding DataContext.EewBodyLineHeight, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource EewLinePosition}">
                        <Binding Path="FontFamily" RelativeSource="{RelativeSource Self}" />
                        <Binding Path="FontSize" RelativeSource="{RelativeSource Self}" />
                        <Binding Path="LineHeight" RelativeSource="{RelativeSource Self}" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEewHeader}" Value="True">
                    <Setter Property="FontSize"
                            Value="{Binding DataContext.EewHeaderFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <Setter Property="LineHeight"
                            Value="{Binding DataContext.EewHeaderLineHeight, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <Setter Property="TextAlignment" Value="Center" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StyleToken}" Value="eew-warning">
                    <Setter Property="Foreground" Value="#FFF0F000" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EewDetailText" TargetType="TextBlock" BasedOn="{StaticResource EewText}">
            <Setter Property="FontSize"
                    Value="{Binding DataContext.EewDetailFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Grid Width="1920" Height="1080" ClipToBounds="True" Clip="{Binding OutputClipGeometry}"
              RenderTransformOrigin="0.5,0.5">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Background"
                            Value="{Binding BackgroundMode, Converter={StaticResource BackgroundBrush}}" />
                </Style>
            </Grid.Style>
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="{Binding OutputScale}" ScaleY="{Binding OutputScale}" />
                    <TranslateTransform X="{Binding OutputOffsetX}" Y="{Binding OutputOffsetY}" />
                </TransformGroup>
            </Grid.RenderTransform>
            <Border Margin="24" Padding="{Binding BannerPadding}" HorizontalAlignment="Left" VerticalAlignment="Top"
                    MaxWidth="1344" CornerRadius="13" Background="#FFFFE600"
                    BorderBrush="#FFD00000" BorderThickness="5"
                    Visibility="{Binding HasRehearsalLabel, Converter={StaticResource BoolVisibility}}"
                    Panel.ZIndex="10">
                <TextBlock Text="{Binding RehearsalLabel}"
                           Foreground="#FF111111"
                           FontFamily="{Binding SubtitleFontFamily}"
                           FontWeight="Black"
                           FontSize="{Binding BannerFontSize}"
                           LineStackingStrategy="BlockLineHeight"
                           LineHeight="{Binding BannerLineHeight}"
                           TextWrapping="NoWrap" />
            </Border>

            <!-- 旧HTML版と同じ、全幅の見出し＋一体型の青いEEW本文。 -->
            <Grid x:Name="EewPanel" ClipToBounds="True" VerticalAlignment="Top"
                  MinHeight="570" Background="#FF3A3AD0"
                  Visibility="{Binding IsEewProgram, Converter={StaticResource BoolVisibility}}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Margin" Value="8,0,8,55" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasRehearsalLabel}" Value="True">
                                <Setter Property="Margin" Value="8,140,8,55" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <ItemsControl ItemsSource="{Binding Blocks}" VerticalAlignment="Top">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource EewBlockBorderStyle}">
                                <StackPanel>
                                    <controls:EewCaptionText SourceText="{Binding PrimaryText}" AreaLabels="{Binding EewAreaLabels}"
                                                             Style="{StaticResource EewPrimaryText}" />
                                    <TextBlock Text="{Binding SecondaryText}" Style="{StaticResource EewDetailText}" />
                                    <TextBlock Text="{Binding EewEstimateText}" Style="{StaticResource EewDetailText}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- HTML版 .sub-rows と同じ余白・透明行・縦方向フロー。 -->
            <Grid Margin="154,140,115,55" ClipToBounds="True"
                  Visibility="{Binding IsSubtitleProgram, Converter={StaticResource BoolVisibility}}">
                <StackPanel VerticalAlignment="Top">
                <ItemsControl ItemsSource="{Binding Blocks}" VerticalAlignment="Top" Grid.IsSharedSizeScope="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="{Binding CaptionColumnGroup}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:CaptionBadgeLayout Grid.Column="0" VerticalAlignment="Top"
                                      Visibility="{Binding HasBadgeColumn, Converter={StaticResource BoolVisibility}}">
                                    <controls:CaptionBadgeLayout.Style>
                                        <Style TargetType="controls:CaptionBadgeLayout">
                                            <Setter Property="MinHeight" Value="{Binding DataContext.SubtitleFirstLineHeight, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            <Setter Property="Caption" Value="{Binding ElementName=StandardPrimaryCaption}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTsunami}" Value="True">
                                                    <Setter Property="Caption" Value="{Binding ElementName=TsunamiAreaCaption}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsWeather}" Value="True">
                                                    <Setter Property="Margin" Value="0,0,0,18" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasWeatherContext}" Value="True">
                                                    <Setter Property="Caption" Value="{Binding ElementName=WeatherContextCaption}" />
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsWeather}" Value="True" />
                                                        <Condition Binding="{Binding HasWeatherContext}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Grid.ColumnSpan" Value="2" />
                                                    <Setter Property="MinHeight" Value="0" />
                                                    <Setter Property="Caption" Value="{x:Null}" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </controls:CaptionBadgeLayout.Style>
                                    <Border Padding="{Binding DataContext.BadgePadding, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            MinWidth="{Binding DataContext.BadgeMinWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CornerRadius="9"
                                            Background="{Binding BadgeBackground}"
                                            BorderBrush="{Binding BadgeBorderBrush}"
                                            BorderThickness="{Binding BadgeBorderThickness}"
                                            Opacity="{Binding BadgeOpacity}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SharesCaptionColumn}" Value="True">
                                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsWeather}" Value="True">
                                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="7" ShadowDepth="3" Opacity="0.8" />
                                        </Border.Effect>
                                        <TextBlock Text="{Binding BadgePlaceholder}"
                                                   Foreground="{Binding BadgeForeground}"
                                                   FontFamily="{Binding DataContext.SubtitleFontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   FontWeight="Black"
                                                   FontSize="{Binding DataContext.BadgeFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   TextAlignment="Center"
                                                   LineStackingStrategy="BlockLineHeight"
                                                   LineHeight="{Binding DataContext.BadgeFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </Border>
                                </controls:CaptionBadgeLayout>
                                <controls:OutlinedText Grid.Column="0" HorizontalAlignment="Left"
                                                       Text="{Binding SubtitleLabel}"
                                                       FontSize="{Binding DataContext.SubtitleFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       LineHeight="{Binding DataContext.SubtitleLineHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       LetterSpacing="{Binding DataContext.SubtitleLetterSpacing, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       StrokeThickness="{Binding DataContext.StrokeThickness, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <controls:OutlinedText x:Name="WeatherContextCaption" Grid.Column="1" Margin="22,0,0,18"
                                                       Text="{Binding WeatherContext}"
                                                       Visibility="{Binding HasWeatherContext, Converter={StaticResource BoolVisibility}}"
                                                       FontSize="{Binding DataContext.SubtitleFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       LineHeight="{Binding DataContext.SubtitleLineHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       LetterSpacing="{Binding DataContext.SubtitleLetterSpacing, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       StrokeThickness="{Binding DataContext.StrokeThickness, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Grid.Column" Value="1" />
                                            <Setter Property="Margin" Value="22,0,0,0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWeather}" Value="True">
                                                    <Setter Property="Grid.Column" Value="0" />
                                                    <Setter Property="Grid.ColumnSpan" Value="2" />
                                                    <Setter Property="Grid.Row" Value="1" />
                                                    <Setter Property="Margin" Value="0" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasLabelColumn}" Value="False">
                                                    <Setter Property="Margin" Value="0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <StackPanel x:Name="StandardSubtitle">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTsunami}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <controls:OutlinedText x:Name="StandardPrimaryCaption" Text="{Binding RenderedPrimaryText}"
                                                               FontSize="{Binding DataContext.SubtitleFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               LineHeight="{Binding DataContext.SubtitleLineHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               LetterSpacing="{Binding DataContext.SubtitleLetterSpacing, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               StrokeThickness="{Binding DataContext.StrokeThickness, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        <controls:OutlinedText Text="{Binding SecondaryText}"
                                                               FontSize="{Binding DataContext.SubtitleFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               LineHeight="{Binding DataContext.SubtitleLineHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               LetterSpacing="{Binding DataContext.SubtitleLetterSpacing, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               StrokeThickness="{Binding DataContext.StrokeThickness, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </StackPanel>
                                    <controls:TsunamiCaptionPanel x:Name="TsunamiSubtitle">
                                        <controls:TsunamiCaptionPanel.Style>
                                            <Style TargetType="controls:TsunamiCaptionPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTsunami}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </controls:TsunamiCaptionPanel.Style>
                                        <controls:OutlinedText x:Name="TsunamiAreaCaption" Text="{Binding RenderedPrimaryText}"
                                                               FontSize="{Binding DataContext.SubtitleFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               LineHeight="{Binding DataContext.SubtitleLineHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               LetterSpacing="{Binding DataContext.SubtitleLetterSpacing, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               StrokeThickness="{Binding DataContext.StrokeThickness, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        <controls:OutlinedText Text="{Binding SecondaryText}" Margin="14,0,0,0"
                                                               FontSize="{Binding DataContext.SubtitleNoteFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               LineHeight="{Binding DataContext.SubtitleNoteLineHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               LetterSpacing="{Binding DataContext.SubtitleLetterSpacing, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               StrokeThickness="{Binding DataContext.StrokeThickness, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </controls:TsunamiCaptionPanel>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
            </Grid>
        </Grid>
    </Viewbox>
</UserControl>
