<Window x:Class="EEWTelop.Wpf.WeatherPrefectureSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="気象情報の対象地域"
        Width="620" Height="650" MinWidth="540" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#FF101820" Foreground="White">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="気象情報を表示する地域を選択してください"
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,14" />

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <RadioButton Content="全国（地域を限定しない）"
                         IsChecked="{Binding IsNationwide}"
                         Foreground="White"
                         FontSize="15" Margin="0,0,0,8" />
            <RadioButton Content="選択した都道府県のみ"
                         IsChecked="{Binding IsPrefectureSelection}"
                         Foreground="White"
                         FontSize="15" />
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="#FF526576" BorderThickness="1"
                CornerRadius="5" Padding="10" Background="#FF172431"
                IsEnabled="{Binding IsPrefectureListEnabled}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="すべて選択" Click="OnSelectAllClicked"
                            Padding="14,6" Margin="0,0,8,0" />
                    <Button Content="選択を解除" Click="OnClearAllClicked" Padding="14,6" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Prefectures}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}"
                                          IsChecked="{Binding IsSelected}"
                                          Foreground="White"
                                          Margin="5" FontSize="14" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="キャンセル" IsCancel="True" MinWidth="100"
                    Padding="15,7" Margin="0,0,8,0" />
            <Button Content="決定" Click="OnConfirmClicked" MinWidth="100"
                    Padding="15,7" Background="#FFF4512C" Foreground="White" />
        </StackPanel>
    </Grid>
</Window>
