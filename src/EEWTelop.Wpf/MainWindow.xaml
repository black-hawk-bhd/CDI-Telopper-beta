<Window x:Class="EEWTelop.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CDI-Telopper"
        Icon="Assets/QTelopper.ico"
        Width="760"
        Height="420"
        MinWidth="680"
        MinHeight="360"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#11151C">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#A83218" Padding="22,16">
            <StackPanel>
                <TextBlock Foreground="White" FontSize="26" FontWeight="Bold" Text="CDI-Telopper" />
                <TextBlock Foreground="#FFF2D8" FontSize="14"
                           Text="Comprehensive Disaster Information Telopper" />
                <TextBlock Foreground="#FFF2D8" FontSize="14" Text="受信・表示基盤 診断画面" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="26">
            <TextBlock Foreground="White" FontSize="20" FontWeight="SemiBold" Text="品質基盤を初期化しました" />
            <TextBlock Margin="0,16,0,4" Foreground="#9EABB8" Text="Provider" />
            <TextBlock x:Name="ProviderText" Foreground="White" FontFamily="Consolas" TextWrapping="Wrap" />
            <TextBlock Margin="0,16,0,4" Foreground="#9EABB8" Text="UTC clock" />
            <TextBlock x:Name="ClockText" Foreground="White" FontFamily="Consolas" />
            <Border Margin="0,24,0,0" Background="#2A2412" BorderBrush="#7A5B00" BorderThickness="1" Padding="14">
                <TextBlock Foreground="#FFE600" TextWrapping="Wrap"
                           Text="受信プロバイダーとページ生成基盤を初期化しました。通常運用にはCDI-Telopper操作画面を使用してください。" />
            </Border>
        </StackPanel>

        <Border Grid.Row="2" Background="#202733" Padding="16,10">
            <TextBlock Foreground="#AAB4C0" Text="Domain / Application / Infrastructure / WPF dependency gate active" />
        </Border>
    </Grid>
</Window>
