<Window x:Class="EEWTelop.Wpf.TelegramReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EEWTelop.Wpf"
        xmlns:controls="clr-namespace:EEWTelop.Wpf.Controls"
        Title="CDI-Telopper 受信・過去電文確認"
        Icon="Assets/CDI-Telopper.ico"
        Width="1180" Height="760" MinWidth="900" MinHeight="600"
        Background="#FF0F141B" Foreground="White"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#FF18212B" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FF9AA8B7" />
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Yu Gothic UI, Meiryo" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#FF334454" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Yu Gothic UI, Meiryo" />
            <Setter Property="Margin" Value="0,0,20,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="受信・過去電文確認" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="本番で受信した電文と、設定した履歴元から取得した過去電文を確認します。"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="過去電文を取得"
                        Command="{Binding LoadHistoryForReviewCommand}" />
                <Button Content="閉じる" Click="OnCloseClicked" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#FF202C38" CornerRadius="6" Padding="10" Margin="0,12,0,12">
            <StackPanel>
                <TextBlock Text="{Binding TelegramReviewStatusText}" TextWrapping="Wrap" />
                <Expander Header="取得元と再掲・訓練の表示設定" Foreground="White" Margin="0,8,0,0">
                    <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,8,12,0">
                            <TextBlock Text="過去電文の取得元（取得だけでは字幕・音声は送出しません）" />
                            <ComboBox ItemsSource="{Binding Settings.HistoryApis}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding Settings.HistoryApi}" />
                            <StackPanel IsEnabled="{Binding Settings.IsJmaHistoryApi}" Margin="0,8,0,0">
                                <TextBlock Text="気象庁XMLの対象種別" />
                                <ComboBox ItemsSource="{Binding Settings.JmaHistoryContents}" DisplayMemberPath="Label"
                                          SelectedValuePath="Value" SelectedValue="{Binding Settings.JmaHistoryContent}" />
                                <TextBlock Text="気象庁の個別XML URL（任意・指定時はその1件のみ）" Margin="0,5,0,0" />
                                <TextBox Text="{Binding Settings.JmaHistoryReportUrl, UpdateSourceTrigger=PropertyChanged}" MaxLength="2048" />
                                <TextBlock Text="公式の長期フィードは数日分・毎時更新。EEWは対象外です。それ以前はNIIまたは保存済みXMLを利用してください。"
                                           TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                            <Expander Header="NII・外部XMLの設定" Foreground="White" Margin="0,8,0,0">
                                <StackPanel>
                                    <StackPanel IsEnabled="{Binding Settings.IsNiiHistoryApi}">
                                        <TextBlock Text="NII検索日・取得対象（最大20件）" />
                                        <DatePicker SelectedDate="{Binding Settings.NiiHistoryDate}" />
                                        <ComboBox ItemsSource="{Binding Settings.NiiHistoryContents}" DisplayMemberPath="Label"
                                                  SelectedValuePath="Value" SelectedValue="{Binding Settings.NiiHistoryContent}" />
                                        <TextBlock Text="NII個別電文URL（任意・検索日より優先）" />
                                        <TextBox Text="{Binding Settings.NiiHistoryReportUrl, UpdateSourceTrigger=PropertyChanged}" MaxLength="2048" />
                                        <TextBlock Text="データ提供：気象庁防災情報XMLデータベース（国立情報学研究所）／CC BY 4.0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Text="外部JMA XML（最大2MiB）" Margin="0,6,0,0" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="XMLを選択…" Command="{Binding BrowseHistoryXmlFileCommand}" />
                                        <TextBox Text="{Binding Settings.LocalHistoryXmlFilePath}" IsReadOnly="True" />
                                    </DockPanel>
                                </StackPanel>
                            </Expander>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                                <TextBlock Text="取得件数（1～100）" VerticalAlignment="Center" />
                                <TextBox Text="{Binding Settings.HistoryLimit}" Width="65" Margin="8,0,0,0" />
                            </StackPanel>
                            <CheckBox Content="再掲・訓練・リハーサル時、上部の区分バッジを非表示"
                                      Foreground="White" IsChecked="{Binding Settings.HideReplayModeBanner}" />
                            <CheckBox Content="再掲・訓練・リハーサル時、情報種別をバッジではなく字幕で表示"
                                      Foreground="White" IsChecked="{Binding Settings.HideReplayInformationBadges}"
                                      ToolTip="ONでは情報種別・震度の文字を字幕に残し、バッジの背景・枠を表示しません。OFFは従来のバッジ表示です。過去情報・動作訓練・Simulator・Sandbox・自動再掲にも適用します。上部の区分表示は別設定です。" />
                            <CheckBox Content="再掲の最終ページに「これは○月○日○時○分発表の情報です」を追加"
                                      Foreground="White" IsChecked="{Binding Settings.AppendReplayIssuedAtPage}" />
                            <TextBlock Text="非表示にすると本番と見分けにくくなります。誤送出に注意してください。内部の訓練区分・元電文は変わりません。新着本番には適用しません。設定の保存はメイン画面の［保存して反映］で行います。"
                                       Foreground="#FFFFC66D" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Expander>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="#FF18212B" CornerRadius="6" Padding="10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="再表示方法" FontWeight="Bold" Margin="0,0,0,7" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="本番情報の再掲"
                                     GroupName="TelegramReplayMode"
                                     IsChecked="{Binding IsProductionReplayMode}"
                                     IsEnabled="{Binding CanUseProductionReplayMode}"
                                     ToolTip="本番で受信した電文だけ選択できます。" />
                        <RadioButton Content="過去情報として紹介"
                                     GroupName="TelegramReplayMode"
                                     IsChecked="{Binding IsPastInformationReplayMode}" />
                        <RadioButton Content="動作訓練"
                                     GroupName="TelegramReplayMode"
                                     IsChecked="{Binding IsTrainingReplayMode}" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="選択した方式で再表示"
                        Command="{Binding RedisplayReceivedTelegramCommand}"
                        Background="#FFEF5B35"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="4,2,4,8">
                        <TextBlock Text="電文一覧（新しい順）" FontWeight="Bold" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding ReviewCategoryOptions}" DisplayMemberPath="Label"
                                  SelectedValuePath="Value" SelectedValue="{Binding SelectedReviewCategory}"
                                  Foreground="Black" Background="White" Padding="6,4"
                                  AutomationProperties.Name="電文一覧の種別"
                                  ToolTip="確認画面だけを絞り込みます。配信用字幕・音声の設定は変わりません。" />
                        <TextBlock Text="{Binding ReviewTelegramsView.Count, StringFormat=該当 {0} 件}"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                    </StackPanel>
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding ReviewTelegramsView}"
                             SelectedItem="{Binding SelectedReceivedTelegram}"
                             Background="#FF0B1016" Foreground="White"
                             BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" Margin="5" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="選択した電文" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="{Binding SelectedReceivedTelegram.DetailText}"
                                   Margin="0,10,0,14" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding SelectedReceivedTelegram.Pages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FF0B1016" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Header}" FontWeight="Bold"
                                                       Foreground="#FFFFC66D" Margin="0,0,0,6" />
                                            <controls:ReviewRubyText SourceText="{Binding Title}" Places="{Binding Places}" TextWrapping="Wrap" FontSize="18"
                                                                    FontWeight="Bold" Foreground="#FFFFC66D" />
                                            <controls:ReviewRubyText SourceText="{Binding Text}" Places="{Binding Places}" TextWrapping="Wrap" FontSize="16"
                                                                    FontFamily="Yu Gothic UI, Meiryo" Foreground="White" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
