<Window x:Class="EEWTelop.Wpf.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EEWTelop.Wpf.Views"
        Title="CDI-Telopper プレビュー"
        Icon="Assets/QTelopper.ico"
        Width="1120" Height="700" MinWidth="640" MinHeight="420"
        Background="#FF202733" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Border BorderBrush="#FF52606D" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
            <Border.Background>
                <DrawingBrush TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <GeometryDrawing Brush="#FF303844" Geometry="M0,0 H24 V24 H0 Z" />
                            <GeometryDrawing Brush="#FF3B4552" Geometry="M0,0 H12 V12 H0 Z M12,12 H24 V24 H12 Z" />
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Border.Background>
            <views:TelopView />
        </Border>
    </Grid>
</Window>
