<Window x:Class="EEWTelop.Wpf.SubtitleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="表示中の字幕を編集"
        Width="920" Height="690" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#FF101820" Foreground="White">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock x:Name="EditorHeading" Text="表示中の字幕をページ単位で編集します"
                       FontSize="20" FontWeight="Bold" />
            <TextBlock Text="{Binding ProgramDescription}"
                       Foreground="#FFB9CCDD" Margin="0,4,0,0" />
            <TextBlock Text="受信データと履歴は変更されません。新着・更新・取消情報を受信すると手動編集は解除されます。"
                       Foreground="#FFFFC857" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="#FF172431" BorderBrush="#FF526576"
                    BorderThickness="1" CornerRadius="5" Padding="8">
                <ListBox ItemsSource="{Binding Pages}"
                         SelectedItem="{Binding SelectedPage}"
                         DisplayMemberPath="Label"
                         Background="#FF101820" Foreground="White"
                         BorderThickness="0" />
            </Border>

            <Border Grid.Column="2" Background="#FF172431" BorderBrush="#FF526576"
                    BorderThickness="1" CornerRadius="5" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding SelectedPage.Blocks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FF101820" BorderBrush="#FF405568"
                                        BorderThickness="1" CornerRadius="4"
                                        Padding="10" Margin="0,0,0,10"
                                        IsEnabled="{Binding IsEditable}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.ColumnSpan="2"
                                                   Text="{Binding StyleDescription, StringFormat=表示スタイル: {0}}"
                                                   Foreground="#FF8FA8BC" Margin="0,0,0,8" />
                                        <TextBlock Grid.Row="1" Text="バッジ" Margin="0,6,10,0" />
                                        <TextBox Grid.Row="1" Grid.Column="1"
                                                 Text="{Binding Badge, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="7,5" />
                                        <TextBlock Grid.Row="2" Text="本文" Margin="0,10,10,0" />
                                        <TextBox Grid.Row="2" Grid.Column="1"
                                                 Text="{Binding PrimaryText, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 MinHeight="55" Padding="7,5" Margin="0,6,0,0" />
                                        <TextBlock Grid.Row="3" Text="補足文" Margin="0,10,10,0" />
                                        <TextBox Grid.Row="3" Grid.Column="1"
                                                 Text="{Binding SecondaryText, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 MinHeight="55" Padding="7,5" Margin="0,6,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Button Content="元の字幕に戻す" Click="OnResetClicked"
                    HorizontalAlignment="Left" Padding="15,7" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="キャンセル" IsCancel="True" MinWidth="100"
                        Padding="15,7" Margin="0,0,8,0" />
                <Button x:Name="ApplyButton" Content="表示に反映" Click="OnApplyClicked" MinWidth="120"
                        Padding="15,7" Background="#FFF4512C" Foreground="White" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
