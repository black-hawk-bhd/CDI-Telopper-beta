<Window x:Class="EEWTelop.Wpf.PendingSubtitleSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="表示前の字幕を選択"
        Width="780" Height="430" MinWidth="620" MinHeight="330"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#FF101820" Foreground="White">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="編集する表示待ち字幕を選択してください"
                       FontSize="20" FontWeight="Bold" />
            <TextBlock Text="編集後も現在の表示順と優先度は変わりません。情報の更新・取消時には編集内容を破棄します。"
                       Foreground="#FFFFC857" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="#FF172431" BorderBrush="#FF526576"
                BorderThickness="1" CornerRadius="5" Padding="8">
            <ListBox ItemsSource="{Binding Items}"
                     SelectedItem="{Binding SelectedItem}"
                     DisplayMemberPath="Label"
                     Background="#FF101820" Foreground="White"
                     BorderThickness="0" FontSize="15"
                     HorizontalContentAlignment="Stretch" />
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="キャンセル" IsCancel="True" MinWidth="100"
                    Padding="15,7" Margin="0,0,8,0" />
            <Button Content="編集する" Click="OnEditClicked" MinWidth="110"
                    Padding="15,7" Background="#FFF4512C" Foreground="White" />
        </StackPanel>
    </Grid>
</Window>
