<Project>
  <Target Name="ValidateSelfContainedRuntimeSecurityVersion"
          AfterTargets="ResolveFrameworkReferences"
          Condition="'$(SelfContained)' == 'true' and '$(TargetFrameworkIdentifier)' == '.NETCoreApp' and '$(TargetFrameworkVersion)' == 'v10.0'">
    <Error Condition="'$(RuntimeFrameworkVersion)' != '' and $([MSBuild]::VersionLessThan('$(RuntimeFrameworkVersion)', '10.0.14'))"
           Text="Self-contained .NET 10 builds require runtime 10.0.14 or newer. Update the SDK/runtime; do not distribute vulnerable runtime packs." />
    <Error Condition="'@(ResolvedRuntimePack)' != '' and '%(ResolvedRuntimePack.NuGetPackageVersion)' != '' and $([MSBuild]::VersionLessThan('%(ResolvedRuntimePack.NuGetPackageVersion)', '10.0.14'))"
           Text="Runtime pack %(ResolvedRuntimePack.NuGetPackageId) %(ResolvedRuntimePack.NuGetPackageVersion) is below the security baseline 10.0.14." />
  </Target>
</Project>
