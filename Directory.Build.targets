<Project>
  <Target Name="ValidateSelfContainedRuntimeSecurityVersion"
          AfterTargets="ResolveFrameworkReferences"
          Condition="'$(SelfContained)' == 'true' and '$(TargetFrameworkIdentifier)' == '.NETCoreApp' and '$(TargetFrameworkVersion)' == 'v8.0'">
    <Error Condition="'$(RuntimeFrameworkVersion)' != '' and $([MSBuild]::VersionLessThan('$(RuntimeFrameworkVersion)', '8.0.32'))"
           Text="Self-contained .NET 8 builds require runtime 8.0.32 or newer. Update the SDK/runtime; do not distribute vulnerable runtime packs." />
    <Error Condition="'@(ResolvedRuntimePack)' != '' and '%(ResolvedRuntimePack.NuGetPackageVersion)' != '' and $([MSBuild]::VersionLessThan('%(ResolvedRuntimePack.NuGetPackageVersion)', '8.0.32'))"
           Text="Runtime pack %(ResolvedRuntimePack.NuGetPackageId) %(ResolvedRuntimePack.NuGetPackageVersion) is below the security baseline 8.0.32." />
  </Target>
</Project>
